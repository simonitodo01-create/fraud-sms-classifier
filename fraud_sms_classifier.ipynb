{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Fraud SMS Classifier\n",
    "## Nigerian SMS Spam & Fraud Detection\n",
    "\n",
    "This notebook builds a machine learning classifier to detect fraudulent SMS messages common in Nigeria (fake bank alerts, lottery scams, etc.)."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Import Libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.model_selection import train_test_split, cross_val_score\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "from sklearn.naive_bayes import MultinomialNB\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import (\n",
    "    accuracy_score, precision_score, recall_score, f1_score,\n",
    "    confusion_matrix, classification_report, roc_auc_score, roc_curve\n",
    ")\n",
    "import re\n",
    "import nltk\n",
    "from nltk.corpus import stopwords\n",
    "from nltk.tokenize import word_tokenize\n",
    "\n",
    "# Download NLTK data\n",
    "nltk.download('stopwords')\n",
    "nltk.download('punkt')\n",
    "\n",
    "# Set style for visualizations\n",
    "sns.set_style('whitegrid')\n",
    "plt.rcParams['figure.figsize'] = (12, 6)\n",
    "\n",
    "print(\"✓ All libraries imported successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load sample dataset\n",
    "df = pd.read_csv('data/sample_messages.csv')\n",
    "\n",
    "print(f\"Dataset shape: {df.shape}\")\n",
    "print(f\"\\nFirst 5 rows:\")\n",
    "print(df.head())\n",
    "print(f\"\\nLabel distribution:\")\n",
    "print(df['label'].value_counts())\n",
    "print(f\"\\nLabel percentages:\")\n",
    "print(df['label'].value_counts(normalize=True) * 100)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Text Preprocessing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def preprocess_text(text):\n",
    "    text = text.lower()\n",
    "    text = re.sub(r'http\\\\S+|www\\\\S+|https\\\\S+', '', text, flags=re.MULTILINE)\n",
    "    text = re.sub(r'[^a-zA-Z0-9\\\\s]', '', text)\n",
    "    text = re.sub(r'\\\\s+', ' ', text).strip()\n",
    "    return text\n",
    "\n",
    "df['cleaned_message'] = df['message'].apply(preprocess_text)\n",
    "print(\"Sample preprocessing:\")\n",
    "print(f\"Original: {df['message'].iloc[0]}\")\n",
    "print(f\"Cleaned: {df['cleaned_message'].iloc[0]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Fraud Keywords Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fraud_keywords = ['won', 'winner', 'congratulations', 'claim', 'prize', 'lottery', 'urgent', 'verify', 'confirm', 'account', 'suspended', 'compromised', 'click', 'link', 'update', 'reset', 'password', 'credentials', 'bank', 'alert', 'reward', 'selected', 'lucky', 'immediately', 'now', 'limited', 'free']\n",
    "\n",
    "def count_fraud_keywords(text):\n",
    "    text_lower = text.lower()\n",
    "    return sum(1 for keyword in fraud_keywords if keyword in text_lower)\n",
    "\n",
    "df['fraud_keyword_count'] = df['message'].apply(count_fraud_keywords)\n",
    "print(\"Fraud keyword analysis:\")\n",
    "print(df[['message', 'label', 'fraud_keyword_count']].head(10))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Feature Vectorization (TF-IDF)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "vectorizer = TfidfVectorizer(max_features=100, min_df=1, max_df=0.8, stop_words='english')\n",
    "X_tfidf = vectorizer.fit_transform(df['cleaned_message'])\n",
    "print(f\"TF-IDF matrix shape: {X_tfidf.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Train/Test Split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df['label_encoded'] = (df['label'] == 'fraud').astype(int)\n",
    "X_train, X_test, y_train, y_test = train_test_split(X_tfidf, df['label_encoded'], test_size=0.2, random_state=42, stratify=df['label_encoded'])\n",
    "print(f\"Training set size: {X_train.shape[0]}\")\n",
    "print(f\"Test set size: {X_test.shape[0]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Train Naive Bayes Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "nb_model = MultinomialNB()\n",
    "nb_model.fit(X_train, y_train)\n",
    "y_pred_nb = nb_model.predict(X_test)\n",
    "y_pred_proba_nb = nb_model.predict_proba(X_test)[:, 1]\n",
    "print(\"✓ Naive Bayes model trained!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Train Random Forest Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "rf_model = RandomForestClassifier(n_estimators=100, random_state=42, n_jobs=-1)\n",
    "rf_model.fit(X_train, y_train)\n",
    "y_pred_rf = rf_model.predict(X_test)\n",
    "y_pred_proba_rf = rf_model.predict_proba(X_test)[:, 1]\n",
    "print(\"✓ Random Forest model trained!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Model Evaluation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def evaluate_model(y_true, y_pred, y_pred_proba, model_name):\n",
    "    print(f\"\\n{'='*50}\")\n",
    "    print(f\"Model: {model_name}\")\n",
    "    print(f\"{'='*50}\")\n",
    "    accuracy = accuracy_score(y_true, y_pred)\n",
    "    precision = precision_score(y_true, y_pred)\n",
    "    recall = recall_score(y_true, y_pred)\n",
    "    f1 = f1_score(y_true, y_pred)\n",
    "    roc_auc = roc_auc_score(y_true, y_pred_proba)\n",
    "    print(f\"Accuracy:  {accuracy:.4f}\")\n",
    "    print(f\"Precision: {precision:.4f}\")\n",
    "    print(f\"Recall:    {recall:.4f}\")\n",
    "    print(f\"F1-Score:  {f1:.4f}\")\n",
    "    print(f\"ROC-AUC:   {roc_auc:.4f}\")\n",
    "    return {'accuracy': accuracy, 'precision': precision, 'recall': recall, 'f1': f1, 'roc_auc': roc_auc}\n",
    "\n",
    "nb_metrics = evaluate_model(y_test, y_pred_nb, y_pred_proba_nb, 'Naive Bayes')\n",
    "rf_metrics = evaluate_model(y_test, y_pred_rf, y_pred_proba_rf, 'Random Forest')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Confusion Matrices"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "cm_nb = confusion_matrix(y_test, y_pred_nb)\n",
    "sns.heatmap(cm_nb, annot=True, fmt='d', cmap='Blues', ax=axes[0], xticklabels=['Safe', 'Fraud'], yticklabels=['Safe', 'Fraud'])\n",
    "axes[0].set_title('Naive Bayes - Confusion Matrix')\n",
    "cm_rf = confusion_matrix(y_test, y_pred_rf)\n",
    "sns.heatmap(cm_rf, annot=True, fmt='d', cmap='Greens', ax=axes[1], xticklabels=['Safe', 'Fraud'], yticklabels=['Safe', 'Fraud'])\n",
    "axes[1].set_title('Random Forest - Confusion Matrix')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 11. ROC Curves"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.metrics import roc_curve\n",
    "fig, ax = plt.subplots(figsize=(10, 7))\n",
    "fpr_nb, tpr_nb, _ = roc_curve(y_test, y_pred_proba_nb)\n",
    "ax.plot(fpr_nb, tpr_nb, label=f'Naive Bayes (AUC={nb_metrics[\"roc_auc\"]:.3f})', linewidth=2)\n",
    "fpr_rf, tpr_rf, _ = roc_curve(y_test, y_pred_proba_rf)\n",
    "ax.plot(fpr_rf, tpr_rf, label=f'Random Forest (AUC={rf_metrics[\"roc_auc\"]:.3f})', linewidth=2)\n",
    "ax.plot([0, 1], [0, 1], 'k--', label='Random Classifier', linewidth=1)\n",
    "ax.set_xlabel('False Positive Rate', fontsize=12)\n",
    "ax.set_ylabel('True Positive Rate', fontsize=12)\n",
    "ax.set_title('ROC Curves - Model Comparison', fontsize=14, fontweight='bold')\n",
    "ax.legend(loc='lower right', fontsize=11)\n",
    "ax.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 12. Test Predictions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "test_messages = [\n",
    "    \"Congratulations! You have won N2 million in our monthly draw. Click here to claim your prize now!\",\n",
    "    \"Your GTBank account has been compromised. Verify your credentials immediately at this link.\",\n",
    "    \"Hi, just checking if you're free for lunch tomorrow?\",\n",
    "    \"Your Uber ride is 5 minutes away. Driver name is Ahmed.\",\n",
    "    \"URGENT: Update your bank password now or your account will be suspended forever!\"\n",
    "]\n",
    "\n",
    "print(\"\\n" + "="*70)\n",
    "print(\"SMS FRAUD DETECTION - LIVE DEMO\")\n",
    "print(\"="*70)\n",
    "\n",
    "for i, msg in enumerate(test_messages, 1):\n",
    "    cleaned = preprocess_text(msg)\n",
    "    X_input = vectorizer.transform([cleaned])\n",
    "    pred = rf_model.predict(X_input)[0]\n",
    "    conf = rf_model.predict_proba(X_input)[0][int(pred)]\n",
    "    kw_count = count_fraud_keywords(msg)\n",
    "    print(f\"\\n📱 Message {i}:\")\n",
    "    print(f\"   Prediction: {'FRAUD' if pred == 1 else 'SAFE'}\")\n",
    "    print(f\"   Confidence: {conf*100:.2f}%\")\n",
    "    print(f\"   Fraud Keywords: {kw_count}\")"
   ]
  }
 ],
